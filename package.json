{
  "name": "sulayman-bowles-portfolio",
  "version": "2.0.0",
  "description": "Sulayman Bowles \u2014 work, writing, and interactive studies",
  "keywords": [
    "interaction",
    "pointer-events"
  ],
  "main": "src/index.tsx",
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "@vercel/functions": "3.7.5",
    "isbot": "5.2.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "sharp": "0.35.5",
    "tsx": "4.21.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr tools/render-public-site.tsx --outDir .cache/public-site --emptyOutDir && node .cache/public-site/render-public-site.js",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests tools index.html vite.config.ts tsconfig.json package.json",
    "optimize:model": "node tools/optimize-model.mjs",
    "prepare:assets": "node tools/prepare-assets.mjs",
    "test:bot-observer": "node --import tsx --test packages/bot-observer/tests/*.test.ts",
    "verify:release": "node tools/verify-release.mjs",
    "optimize:portfolio": "node tools/optimize-portfolio-assets.mjs",
    "verify:portfolio": "node tools/optimize-portfolio-assets.mjs --verify-only"
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true
}
