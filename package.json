{
  "name": "sulayman-bowles-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:article-routes",
    "dev": "vite --port=3000 --host=127.0.0.1",
    "prebuild": "npm run generate:article-routes",
    "build": "npm run generate:public && vite build && tsx scripts/generate-static-routes.ts",
    "preview": "vite preview",
    "prelint": "npm run generate:article-routes",
    "report:article-rankings": "tsx scripts/report-article-rankings.ts",
    "report:pseo-growth": "tsx scripts/report-pseo-growth.ts",
    "clean": "rm -rf dist server.js",
    "generate:article-routes": "tsx scripts/generate-article-route-metadata.ts",
    "generate:public": "tsx scripts/generate-public-files.ts",
    "lint": "tsc --noEmit",
    "audit:content-similarity": "tsx scripts/audit-content-similarity.ts",
    "audit:style": "node scripts/style-audit.mjs",
    "benchmark:austin": "node scripts/build-austin-crawlability-benchmark.mjs",
    "linkbuilding:external-check": "node scripts/check-link-building-external.mjs",
    "linkbuilding:export-publish": "node scripts/export-link-building-publish.mjs",
    "linkbuilding:live-check": "node scripts/check-link-building-live.mjs",
    "linkbuilding:prepare": "node scripts/prepare-link-building.mjs",
    "linkbuilding:scope-check": "node scripts/check-link-building-publish-scope.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "test:bot-observer": "node --import tsx --test packages/bot-observer/tests/*.test.ts",
    "test:portfolio-analytics": "node --import tsx --test src/analytics/portfolioAnalytics.test.ts",
    "test:seo-schema": "node --import tsx --test src/seo/schema.test.ts",
    "verify:bot-observer": "node scripts/verify-bot-observer.mjs",
    "verify:articles": "tsx scripts/verify-technical-article-series.ts",
    "verify:articles-live": "tsx scripts/verify-live-article-routes.ts",
    "verify:article-ranking": "tsx scripts/verify-article-ranking-program.ts",
    "verify:seo": "node scripts/verify-ai-search-seo.mjs",
    "verify:vercel-seo": "node scripts/verify-vercel-seo-routes.mjs",
    "verify:generated": "tsx scripts/verify-generated-public-files.ts",
    "verify:internal-links": "tsx scripts/verify-internal-link-targeting.ts",
    "verify:keywords": "tsx scripts/verify-keyword-targeting.ts",
    "verify:pseo": "tsx scripts/verify-programmatic-seo.ts",
    "verify:pseo-live": "tsx scripts/verify-live-canonical-routes.ts",
    "verify:reduction": "node scripts/verify-portfolio-reduction.mjs",
    "verify:security": "node scripts/verify-security-hardening.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.7.5",
    "@vitejs/plugin-react": "^5.0.4",
    "isbot": "5.2.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
