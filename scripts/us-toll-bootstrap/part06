def add_related_path(text: str, source_path: str, related_path: str) -> str:
    pattern = re.compile(
        r"(  {\n    path: " + re.escape(repr(source_path)) + r",[\s\S]*?    relatedPaths: \[\n)"
    )
    match = pattern.search(text)
    if not match:
        raise RuntimeError(f"articleSearchTargets.ts: unable to locate relatedPaths for {source_path}")
    next_object = text.find("\n  },\n  {", match.end())
    current_object = text[match.start(): next_object if next_object >= 0 else len(text)]
    line = f"      '{related_path}',\n"
    if line in current_object:
        return text
    return text[:match.end()] + line + text[match.end():]


