{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "redirects": [
    {
      "source": "/Sulayman_Bowles_Resume_2025.pdf",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "destination": "https://sulayman-bowles.dev/resume",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "destination": "https://sulayman-bowles.dev/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "destination": "https://sulayman-bowles.dev/:path*",
      "statusCode": 301
    },
    {
      "source": "/Sulayman_Bowles_Resume_2025.pdf",
      "destination": "/resume",
      "statusCode": 301
    },
    {
      "source": "/resume.pdf",
      "destination": "/Sulayman_Bowles_Resume.pdf",
      "statusCode": 301
    },
    { "source": "/projects/atlas", "destination": "/atlas", "permanent": true },
    { "source": "/projects/markets", "destination": "/markets", "permanent": true },
    { "source": "/atlas/sample-run", "destination": "/atlas/sample-crawl", "permanent": true },
    { "source": "/audit-intake", "destination": "/contact", "permanent": true },
    { "source": "/austin-seo", "destination": "/austin-technical-seo", "permanent": true },
    { "source": "/technical-seo-case-study", "destination": "/case-studies/technical-seo-audit", "permanent": true },
    { "source": "/book", "destination": "/simple", "permanent": true },
    { "source": "/plain", "destination": "/simple", "permanent": true },
    { "source": "/text", "destination": "/simple", "permanent": true },
    { "source": "/cv", "destination": "/resume", "permanent": true },
    { "source": "/resume.html", "destination": "/resume", "permanent": true }
  ]
}
