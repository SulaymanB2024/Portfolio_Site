{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "redirects": [
    {
      "source": "/Sulayman_Bowles_Resume_2025.pdf",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "destination": "https://sulayman-bowles.dev/resume",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "destination": "https://sulayman-bowles.dev/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "destination": "https://sulayman-bowles.dev/:path*",
      "statusCode": 301
    },
    {
      "source": "/Sulayman_Bowles_Resume_2025.pdf",
      "destination": "/resume",
      "statusCode": 301
    },
    {
      "source": "/resume.pdf",
      "destination": "/Sulayman_Bowles_Resume.pdf",
      "statusCode": 301
    },
    { "source": "/projects/atlas", "destination": "/atlas", "permanent": true },
    { "source": "/projects/markets", "destination": "/markets", "permanent": true },
    { "source": "/atlas/sample-run", "destination": "/atlas/sample-crawl", "permanent": true },
    { "source": "/atlas-animation", "destination": "/atlas/celestial-parallax", "permanent": true },
    { "source": "/audit-intake", "destination": "/contact", "permanent": true },
    { "source": "/austin-seo", "destination": "/austin-technical-seo", "permanent": true },
    { "source": "/technical-seo-case-study", "destination": "/case-studies/technical-seo-audit", "permanent": true },
    { "source": "/book", "destination": "/simple", "permanent": true },
    { "source": "/plain", "destination": "/simple", "permanent": true },
    { "source": "/text", "destination": "/simple", "permanent": true },
    { "source": "/cv", "destination": "/resume", "permanent": true },
    { "source": "/cv.html", "destination": "/resume", "permanent": true },
    { "source": "/resume.html", "destination": "/resume", "permanent": true },
    { "source": "/official-information", "destination": "/ai-information", "permanent": true },
    { "source": "/entity-profile", "destination": "/ai-information", "permanent": true },
    { "source": "/source-information", "destination": "/ai-information", "permanent": true },
    { "source": "/research-assets", "destination": "/research", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://formspree.io; frame-src 'none'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ]
}
