{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/Sulayman_Bowles_Resume_2025\\.pdf",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "headers": { "Location": "https://sulayman-bowles.dev/resume" },
      "status": 301
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "headers": { "Location": "https://sulayman-bowles.dev/" },
      "status": 301
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.sulayman-bowles.dev" }],
      "headers": { "Location": "https://sulayman-bowles.dev/$1" },
      "status": 301
    },
    {
      "src": "/Sulayman_Bowles_Resume_2025\\.pdf",
      "headers": { "Location": "/resume" },
      "status": 301
    },
    {
      "src": "/resume\\.pdf",
      "headers": { "Location": "/Sulayman_Bowles_Resume.pdf" },
      "status": 301
    },
    { "src": "/projects/atlas", "headers": { "Location": "/atlas" }, "status": 308 },
    { "src": "/projects/markets", "headers": { "Location": "/markets" }, "status": 308 },
    { "src": "/atlas/sample-run", "headers": { "Location": "/atlas/sample-crawl" }, "status": 308 },
    { "src": "/atlas-animation", "headers": { "Location": "/atlas/celestial-parallax" }, "status": 308 },
    { "src": "/audit-intake", "headers": { "Location": "/contact" }, "status": 308 },
    { "src": "/austin-seo", "headers": { "Location": "/austin-technical-seo" }, "status": 308 },
    { "src": "/technical-seo-case-study", "headers": { "Location": "/case-studies/technical-seo-audit" }, "status": 308 },
    { "src": "/book", "headers": { "Location": "/simple" }, "status": 308 },
    { "src": "/plain", "headers": { "Location": "/simple" }, "status": 308 },
    { "src": "/text", "headers": { "Location": "/simple" }, "status": 308 },
    { "src": "/cv", "headers": { "Location": "/resume" }, "status": 308 },
    { "src": "/cv\\.html", "headers": { "Location": "/resume" }, "status": 308 },
    { "src": "/resume\\.html", "headers": { "Location": "/resume" }, "status": 308 },
    { "src": "/official-information", "headers": { "Location": "/ai-information" }, "status": 308 },
    { "src": "/entity-profile", "headers": { "Location": "/ai-information" }, "status": 308 },
    { "src": "/source-information", "headers": { "Location": "/ai-information" }, "status": 308 },
    { "src": "/research-assets", "headers": { "Location": "/research" }, "status": 308 },
    { "src": "/markets/ai-search-crawler-policy", "headers": { "Location": "/research/ai-crawlers/ai-search-crawler-policy" }, "status": 308 },
    { "src": "/markets/technical-seo-public-data-infrastructure", "headers": { "Location": "/research/search-console/technical-seo-public-data-infrastructure" }, "status": 308 },
    { "src": "/markets/canonical-identity-personal-seo", "headers": { "Location": "/research/personal-seo/canonical-identity-personal-seo" }, "status": 308 },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://formspree.io; frame-src 'none'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests",
        "Strict-Transport-Security": "max-age=31536000",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Permitted-Cross-Domain-Policies": "none"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404" }
  ]
}
